# Optional. Without these the contact form reports that the relay is offline
# and offers to open the visitor's email app instead. Nothing is faked.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender verified in Resend, e.g. "Portfolio <portfolio@yourdomain.dev>"
CONTACT_FROM_EMAIL=

# Optional. Global leaderboard storage. With neither set, scores are kept in
# .data/scores.json (fine on an always-on Node server; not on serverless).
# Upstash Redis (free tier) or Vercel KV, REST URL and token:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# SCORES_FILE=/var/data/scores.json
